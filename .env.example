# ─── EasyDMARC API Credentials ───────────────────────────────────────────────
# Long-lived client_id/client_secret used in env mode (single shared
# credential loaded from environment), from EasyDMARC's Account Console
# (API Client management). Not required when AUTH_MODE=gateway (credentials
# are provided per-request via headers instead).
#
# These are NOT a bearer token: EasyDMARC's own access tokens expire in
# ~5 minutes with no refresh, so this server exchanges client_id/secret for
# a fresh token on every API call rather than accepting an already-issued
# one (see src/easydmarc_mcp/api_client.py for why).
EASYDMARC_CLIENT_ID=your_client_id_here
EASYDMARC_CLIENT_SECRET=your_client_secret_here

# Base URL of the EasyDMARC public REST API.
EASYDMARC_BASE_URL=https://api.easydmarc.com

# HTTP header names that carry client_id/client_secret in gateway mode.
# The client must send both headers on every /mcp request.
EASYDMARC_CLIENT_ID_HEADER=X-EasyDMARC-Client-Id
EASYDMARC_CLIENT_SECRET_HEADER=X-EasyDMARC-Client-Secret

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) client_id/secret provided per-request via the
#             EASYDMARC_CLIENT_ID_HEADER/EASYDMARC_CLIENT_SECRET_HEADER HTTP headers
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
# "env"     — (local dev only) single client_id/secret loaded from EASYDMARC_CLIENT_ID/
#             EASYDMARC_CLIENT_SECRET environment variables
#             NOT SOP-compliant: credentials are shared across all requests; do not use in production.
AUTH_MODE=gateway
