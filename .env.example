# ─── EasyDMARC API Credentials ───────────────────────────────────────────────
# Token used in env mode (single shared credential loaded from environment).
# Not required when AUTH_MODE=gateway (token is provided per-request via header).
EASYDMARC_API_TOKEN=your_bearer_jwt_here

# Base URL of the EasyDMARC public REST API.
EASYDMARC_BASE_URL=https://api.easydmarc.com

# HTTP header name that carries the token in gateway mode.
# The client must send this header on every /mcp request.
EASYDMARC_AUTH_HEADER=X-EasyDMARC-Token

# ─── MCP Transport ───────────────────────────────────────────────────────────
# "http"  — stateless HTTP server (required for production / multi-tenant use)
# "stdio" — local stdio transport (useful for development / CLI use)
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
# "gateway" — (default, SOP-compliant) token provided per-request via the EASYDMARC_AUTH_HEADER HTTP header
#             Required for production / multi-tenant deployments (e.g. behind mcp-gateway).
# "env"     — (local dev only) single token loaded from EASYDMARC_API_TOKEN environment variable
#             NOT SOP-compliant: token is shared across all requests; do not use in production.
AUTH_MODE=gateway
